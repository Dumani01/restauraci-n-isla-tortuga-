        "parameters": {
          "jsCode": "const data = $json;\n\nlet fallbackRequestId = null;\ntry {\n  fallbackRequestId = $('Validate & Prepare').first().json.requestId ?? null;\n} catch (_) {}\n\nif (data?.error) {\n  const raw = typeof data.error === 'string'\n    ? data.error\n    : (data.error.message || JSON.stringify(data.error));\n\n  let code = 'AI_SERVICE_UNAVAILABLE';\n  const lowered = String(raw).toLowerCase();\n\n  if (lowered.includes('timeout')) code = 'AI_TIMEOUT';\n  if (lowered.includes('429') || lowered.includes('rate')) code = 'RATE_LIMIT';\n\n  return [{\n    json: {\n      success: false,\n      answer: '',\n      requestId: fallbackRequestId,\n      error: code,\n    },\n  }];\n}\n\nconst answer = data?.choices?.[0]?.message?.content;\n\nif (typeof answer !== 'string' || !answer.trim()) {\n  return [{\n    json: {\n      success: false,\n      answer: '',\n      requestId: data?.id || fallbackRequestId,\n      error: 'INVALID_RESPONSE',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    answer: answer.trim(),\n    requestId: data?.id || fallbackRequestId,\n  },\n}];"
